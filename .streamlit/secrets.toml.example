# Copier ce fichier en `secrets.toml` pour un test local (ne jamais committer
# le vrai secrets.toml — il est dans .gitignore).
# Sur Streamlit Community Cloud : coller ces deux lignes dans
# App settings -> Secrets, avec les vraies valeurs.

SUPABASE_URL = "https://zsnwfikkahecrgcvmrxj.supabase.co"
SUPABASE_ANON_KEY = "sb_publishable_..."

# Proxy isochrones (Valhalla + géocodage), déployé sur acolys-serveur — voir
# ~/moubri/infra/valhalla-vps/. La clé doit correspondre à ISO_PROXY_KEY dans
# le .env de ce dossier sur le serveur (docker-compose iso-proxy).
ISO_PROXY_URL = "http://167.233.169.222:8811"
ISO_PROXY_KEY = "..."

# Verrou de la page Trajectoire patrimoniale (situation financière personnelle) —
# permet de partager le reste du dashboard sans exposer cette page. Choisir un
# mot de passe réel ici (ou dans moubri/.env en local), jamais laisser vide en
# production : sans cette clé, la page reste bloquée pour tout le monde (fail-closed).
TRAJECTOIRE_PASSWORD = "..."
